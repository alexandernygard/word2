{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "word2",
	"compatibility_date": "2026-10-18",
	// Static-assets-only Worker: no server code runs, files are served from Cloudflare's edge.
	"assets": {
		"directory": "./apps/web/dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [{ "pattern": "word2.nyggis.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
